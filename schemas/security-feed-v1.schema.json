{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsec.dev/schemas/security-feed-v1.schema.json",
  "title": "AgentSec public security feed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_license",
    "agentsec",
    "database",
    "landing_metrics",
    "intelligence",
    "detectors",
    "input_digests"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "content_license": { "const": "CC-BY-SA-4.0" },
    "agentsec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "status", "repository_url", "documentation_url", "installation_url", "scan_command"],
      "properties": {
        "name": { "const": "AgentSec Triage" },
        "version": { "type": "string", "minLength": 1 },
        "status": { "const": "alpha" },
        "repository_url": { "$ref": "#/$defs/httpsUrl" },
        "documentation_url": { "$ref": "#/$defs/httpsUrl" },
        "installation_url": { "$ref": "#/$defs/httpsUrl" },
        "scan_command": { "type": "string", "minLength": 1 }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "updated", "record_counts"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "updated": { "$ref": "#/$defs/date" },
        "record_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["attack_techniques", "campaigns", "cves", "malicious_skill_records"],
          "properties": {
            "attack_techniques": { "type": "integer", "minimum": 0 },
            "campaigns": { "type": "integer", "minimum": 0 },
            "cves": { "type": "integer", "minimum": 0 },
            "malicious_skill_records": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "landing_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical_risk_skills", "exposed_servers", "flawed_skills_percent", "malicious_payloads", "skills_scanned"],
      "properties": {
        "critical_risk_skills": { "type": "integer", "minimum": 0 },
        "exposed_servers": { "type": "integer", "minimum": 0 },
        "flawed_skills_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "malicious_payloads": { "type": "integer", "minimum": 0 },
        "skills_scanned": { "type": "integer", "minimum": 0 }
      }
    },
    "intelligence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "updated", "sources", "events"],
      "properties": {
        "schema_version": { "type": "string", "minLength": 1 },
        "updated": { "$ref": "#/$defs/date" },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/source" }
        },
        "events": {
          "type": "array",
          "items": { "$ref": "#/$defs/event" }
        }
      }
    },
    "detectors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/detector" }
    },
    "input_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intelligence_sha256", "threat_database_sha256"],
      "properties": {
        "intelligence_sha256": { "$ref": "#/$defs/sha256" },
        "threat_database_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "date": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "httpsUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "strings": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "publisher", "url", "source_type", "status", "reviewed_date"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/httpsUrl" },
        "source_type": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "published_date": { "$ref": "#/$defs/date" },
        "reviewed_date": { "$ref": "#/$defs/date" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "event_type", "title", "summary", "date", "date_kind", "ecosystems", "status", "confidence", "source_ids", "related", "detector_coverage"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "event_type": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "date": { "$ref": "#/$defs/date" },
        "date_kind": { "enum": ["occurred", "disclosed", "updated"] },
        "ecosystems": { "$ref": "#/$defs/strings" },
        "status": { "type": "string", "minLength": 1 },
        "confidence": { "type": "string", "minLength": 1 },
        "source_ids": { "$ref": "#/$defs/strings" },
        "related": {
          "type": "object",
          "additionalProperties": false,
          "required": ["campaign_ids", "cve_ids", "technique_ids"],
          "properties": {
            "campaign_ids": { "$ref": "#/$defs/strings" },
            "cve_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "technique_ids": { "$ref": "#/$defs/strings" }
          }
        },
        "detector_coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "detector_ids", "summary"],
          "properties": {
            "status": { "type": "string", "minLength": 1 },
            "detector_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "summary": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "detector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "description", "supported_inputs", "campaign_ids", "technique_ids", "source_references", "limitations", "remediation_url", "not_scanned"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "supported_inputs": { "$ref": "#/$defs/strings" },
        "campaign_ids": { "$ref": "#/$defs/strings" },
        "technique_ids": { "$ref": "#/$defs/strings" },
        "source_references": { "type": "array", "items": { "$ref": "#/$defs/httpsUrl" }, "uniqueItems": true },
        "limitations": { "$ref": "#/$defs/strings" },
        "remediation_url": { "$ref": "#/$defs/httpsUrl" },
        "not_scanned": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    }
  }
}
