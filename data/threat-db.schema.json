{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsec.dev/schemas/threat-db-authoring-v1.schema.json",
  "title": "AgentSec threat database authoring source",
  "type": "object",
  "required": [
    "version",
    "updated",
    "sources",
    "malicious_skills",
    "cve_database",
    "iocs",
    "campaigns",
    "attack_techniques"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "url"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "url": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "malicious_skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "source", "risk"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "platform": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "risk": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "cve_database": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "component", "severity"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "component": {"type": "string", "minLength": 1},
          "severity": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "iocs": {
      "type": "object",
      "required": ["malicious_domains", "malware_hashes"],
      "properties": {
        "malicious_domains": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["domain"],
            "properties": {
              "domain": {"type": "string", "minLength": 1},
              "campaign": {"type": "string"},
              "date": {"type": "string"},
              "notes": {"type": "string"}
            },
            "additionalProperties": true
          }
        },
        "malware_hashes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["hash", "type", "source"],
            "properties": {
              "hash": {"type": "string", "minLength": 1},
              "type": {"type": "string", "minLength": 1},
              "source": {"type": "string", "minLength": 1}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "campaigns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "source", "date"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "date": {"type": "string", "minLength": 1},
          "ai_agent_impersonation": {
            "type": "object",
            "required": ["status", "detail", "detection"],
            "properties": {
              "status": {"type": "string", "minLength": 1},
              "detail": {"type": "string", "minLength": 1},
              "detection": {"type": "string", "minLength": 1}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "attack_techniques": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
