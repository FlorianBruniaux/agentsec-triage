{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FlorianBruniaux/agentsec-triage/blob/main/data/competitive-projects.schema.json",
  "title": "AgentSec competitive project index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "projects"],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "url",
          "local_directory",
          "revision",
          "category",
          "evidence_status",
          "execution_tier",
          "license",
          "profile"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://github\\.com/[^/]+/[^/]+/?$"
          },
          "local_directory": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{12}$"
          },
          "category": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "evidence_status": {
            "enum": [
              "declared",
              "code_verified",
              "observed",
              "contradicted",
              "not_applicable",
              "not_tested"
            ]
          },
          "execution_tier": {
            "enum": [
              "static_only",
              "offline_sandbox",
              "networked_sandbox",
              "manual_review"
            ]
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "profile": {
            "type": "string",
            "pattern": "^docs/competitive-analysis/profiles/[a-z0-9][a-z0-9-]*\\.md$"
          }
        }
      }
    }
  }
}
